# ============================================================
# NEET Chemistry App — .gitignore
# Only web-app runtime files go to the repo.
# Everything else stays local.
# ============================================================

# ------ noupload/ -----------------------------------------------
# Local-only folder: source data, build scripts, OCR dumps,
# test files, reference docs. Never pushed.
noupload/

# ------ OS / Editor junk ----------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ------ Python --------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ------ Node / npm ----------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# ------ Claude / AI session files -------------------------------
.claude/

# ------ Test / CI artifacts -------------------------------------
playwright-report/
test-results/
coverage/
.nyc_output/

# ------ Large source / OCR files (catch-all safety net) ---------
# These should live in noupload/ but also caught here just in case
*.pdf
*_by_PaddleOCR*.json
*_by_PaddleOCR*.md
*_by_PaddleOCR*.txt

# ------ Misc generated / intermediate files ---------------------
*.log
*.tmp
*.bak
*.orig
*.patch

# ------ Pearson / Biology import outputs ------------------------
pearson_biology_vol1.*
pearson_biology_vol2.*
Objective-Biology-for-NEET*
bio_classsif.png
